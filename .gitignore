# Generated by deploy, never tracked
.env
data/
*.db

# Roon pairing token, device API tokens — secrets
**/roon_token.json

# Python
__pycache__/
*.pyc
.venv/
.coverage
htmlcov/

# Compiled translation catalogs — rebuilt by the Docker build's pybabel compile step
app/translations/*/LC_MESSAGES/*.mo

# e2e (Playwright)
node_modules/
e2e/.auth/
playwright-report/
test-results/

# check_inline_js.py's eslint temp dir, if a crash ever leaves one behind
dev/tmp*/

# Optional per-checkout additions to the leak scan's pattern list
dev/forbidden-terms.local.txt

# curl cookie jars — never commit a session store (see #83, the stray `-b` file
# from a `curl -b`/`-c` invocation that landed at the repo root)
cookies.txt
*.cookiejar
-b

# CI downloads the gitleaks binary into the repo root for the secret scan;
# never commit it (and keep reuse lint from tripping on it).
/gitleaks

# MkDocs build output (the site is built + deployed by .github/workflows/docs.yml)
site/
