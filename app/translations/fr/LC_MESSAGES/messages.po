msgstr ""
"Laisser le serveur gérer à nouveau « {name} » ? Cela en retirera {n} "
"morceau à sa prochaine synchronisation : aucune sélection ne l'inclut."

#: main.py:1503
#, python-brace-format
msgid ""
"Let the server manage \"{name}\" again? This will remove {n} tracks from "
"it at its next sync: no selection includes them."
msgstr ""
"Laisser le serveur gérer à nouveau « {name} » ? Cela en retirera {n} "
"morceaux à sa prochaine synchronisation : aucune sélection ne les inclut."

