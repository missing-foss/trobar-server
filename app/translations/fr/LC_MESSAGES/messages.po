#: main.py:617
msgid "Cross-site request blocked"
msgstr "Requête intersite bloquée"

#: main.py:855 main.py:992 main.py:999 main.py:1008
msgid "Login required"
msgstr "Connexion requise"

#: main.py:1026
msgid "Too many failed attempts. Please wait a few minutes and try again."
msgstr "Trop de tentatives échouées. Patientez quelques minutes puis réessayez."

#: main.py:1032
msgid "Username and password are required."
msgstr "Nom d'utilisateur et mot de passe requis."

#: main.py:1046
msgid "The first account must use the configured admin username."
msgstr "Le premier compte doit utiliser le nom d'administrateur configuré."

#: main.py:1076
msgid "Invalid credentials."
msgstr "Identifiants invalides."

#: main.py:1103
msgid ""
"SSO is unreachable right now. An administrator can sign in with a local "
"password."
msgstr ""
"Le SSO est injoignable pour le moment. Un administrateur peut se "
"connecter avec un mot de passe local."

#: main.py:1119
msgid "Sign-in failed. Please try again."
msgstr "Échec de la connexion. Réessayez."

#: main.py:1124
msgid "Your identity provider did not return a username."
msgstr "Votre fournisseur d'identité n'a pas renvoyé de nom d'utilisateur."

#: main.py:1167 main.py:8085
msgid "Admin access required"
msgstr "Réservé à l'administrateur"

#: main.py:1184
msgid "Device not found"
msgstr "Appareil introuvable"

#: main.py:1187
msgid "Unauthorized access to this device"
msgstr "Accès non autorisé à cet appareil"

#: main.py:1197
msgid "Selection not found"
msgstr "Sélection introuvable"

msgid "A playlist and a recipient are needed."
msgstr "Il faut une playlist et un destinataire."

msgid "Choose someone else to share with."
msgstr "Choisissez quelqu'un d'autre avec qui partager."

msgid "Nothing to change."
msgstr "Rien à modifier."

msgid "Only an admin can share without an invitation."
msgstr "Seul un administrateur peut partager sans invitation."

msgid "Only the owner can change how a share syncs."
msgstr "Seul le propriétaire peut changer la synchronisation d'un partage."

msgid "Only the person it was shared with can accept it."
msgstr "Seule la personne destinataire du partage peut l'accepter."

msgid "Only the person it was shared with can decline it."
msgstr "Seule la personne destinataire du partage peut le refuser."

msgid "Only the two people sharing it can end it."
msgstr "Seules les deux personnes du partage peuvent y mettre fin."

msgid "Only your own Tidal playlists can be shared."
msgstr "Seules vos propres playlists Tidal peuvent être partagées."

msgid "Share not found"
msgstr "Partage introuvable"

#, python-brace-format
msgid "Profile, {n} invitation"
msgstr "Profil, {n} invitation"

#, python-brace-format
msgid "Profile, {n} invitations"
msgstr "Profil, {n} invitations"

#, python-brace-format
msgid "{n} invitation waiting"
msgstr "{n} invitation en attente"

#, python-brace-format
msgid "{n} invitations waiting"
msgstr "{n} invitations en attente"

#, python-brace-format
msgid "Share “{title}”"
msgstr "Partager « {title} »"

msgid "Tidal linked"
msgstr "Tidal lié"

msgid "needs to reconnect Tidal"
msgstr "doit reconnecter Tidal"

#, python-brace-format
msgid ""
"{name} has to reconnect Tidal before the copy can appear. The invitation "
"waits, and the copy follows once they do."
msgstr ""
"{name} doit reconnecter Tidal avant que la copie puisse apparaître. "
"L'invitation attend, et la copie suit une fois la reconnexion faite."

msgid "Send invitation"
msgstr "Envoyer l'invitation"

msgid "Share now"
msgstr "Partager maintenant"

#, python-brace-format
msgid "Invitation sent to {name}. They answer it on their Profile."
msgstr "Invitation envoyée à {name}, qui y répond depuis son Profil."

#, python-brace-format
msgid ""
"Shared with {name}. The copy appears in their Tidal account at the next "
"playlist sync."
msgstr ""
"Partagée avec {name}. La copie apparaît dans son compte Tidal à la "
"prochaine synchronisation des playlists."

msgid "Waiting for an answer"
msgstr "En attente de réponse"

msgid "New invitation"
msgstr "Nouvelle invitation"

msgid "Syncing"
msgstr "Synchronisée"

msgid "Needs attention"
msgstr "À vérifier"

msgid "Ended"
msgstr "Terminé"

#, python-brace-format
msgid "with {name}"
msgstr "avec {name}"

msgid "one-way"
msgstr "sens unique"

msgid "two-way"
msgstr "dans les deux sens"

#, python-brace-format
msgid "invited {time}"
msgstr "invitation {time}"

#, python-brace-format
msgid "ended {time}"
msgstr "terminé {time}"

#, python-brace-format
msgid "last synced {time}"
msgstr "dernière synchronisation {time}"

msgid "not synced yet"
msgstr "pas encore synchronisée"

#, python-brace-format
msgid ""
"If you accept, Trobar creates “{title}” in your Tidal account and keeps "
"it the same as {name}'s on each playlist sync. Changes you make to it are"
" replaced; rename it if you like, the name stays yours."
msgstr ""
"Si vous acceptez, Trobar crée « {title} » dans votre compte Tidal et la "
"garde identique à celle de {name} à chaque synchronisation des playlists."
" Vos modifications y sont remplacées ; vous pouvez la renommer, le nom "
"reste le vôtre."

#, python-brace-format
msgid ""
"If you accept, Trobar creates “{title}” in your Tidal account and keeps "
"it in step with {name}'s on each playlist sync, both ways: what either of"
" you adds or removes reaches the other."
msgstr ""
"Si vous acceptez, Trobar crée « {title} » dans votre compte Tidal et "
"l'accorde avec celle de {name} à chaque synchronisation des playlists, "
"dans les deux sens : ce que l'un de vous ajoute ou retire arrive chez "
"l'autre."

#, python-brace-format
msgid "{n} track isn't available in your region, so your copy doesn't have it."
msgstr ""
"{n} titre n'est pas disponible dans votre région, votre copie ne l'a donc"
" pas."

#, python-brace-format
msgid ""
"{n} tracks aren't available in your region, so your copy doesn't have "
"them."
msgstr ""
"{n} titres ne sont pas disponibles dans votre région, votre copie ne les "
"a donc pas."

#, python-brace-format
msgid "Stopping keeps your copy as your own playlist, and {name}'s as theirs."
msgstr ""
"Arrêter garde votre copie comme votre propre playlist, et celle de {name}"
" comme la sienne."

#, python-brace-format
msgid "Two-way: {name}'s changes come back to your playlist"
msgstr ""
"Dans les deux sens : les modifications de {name} reviennent dans votre "
"playlist"

#, python-brace-format
msgid ""
"Your original will be deleted at the next playlist sync, once Trobar has "
"checked {name}'s copy still has every track."
msgstr ""
"Votre original sera supprimé à la prochaine synchronisation des "
"playlists, une fois que Trobar aura vérifié que la copie de {name} a "
"encore tous les titres."

#, python-brace-format
msgid "Delete your original “{title}”?"
msgstr "Supprimer votre original « {title} » ?"

#, python-brace-format
msgid ""
"{name}'s copy stays in their Tidal account as their own playlist. Yours "
"is deleted from your Tidal account at the next playlist sync."
msgstr ""
"La copie de {name} reste dans son compte Tidal comme sa propre playlist. "
"La vôtre est supprimée de votre compte Tidal à la prochaine "
"synchronisation des playlists."

#, python-brace-format
msgid "Waiting for Tidal to be linked on both sides, yours and {name}'s."
msgstr ""
"En attente d'un compte Tidal lié des deux côtés, le vôtre et celui de "
"{name}."

msgid "Waiting for a Tidal reconnect before anything can be written."
msgstr ""
"En attente d'une reconnexion à Tidal avant de pouvoir écrire quoi que ce "
"soit."

msgid "The original playlist was deleted in Tidal, so the share ended."
msgstr ""
"La playlist d'origine a été supprimée dans Tidal, le partage est donc "
"terminé."

msgid "The copy was deleted in Tidal, so the share ended."
msgstr "La copie a été supprimée dans Tidal, le partage est donc terminé."

msgid ""
"Two-way needs a playlist you own in Tidal; you only follow this one. "
"Nothing is written until you switch it to one-way."
msgstr ""
"Le partage dans les deux sens demande une playlist qui vous appartient "
"dans Tidal ; vous ne faites que suivre celle-ci. Rien n'est écrit tant "
"que vous ne passez pas en sens unique."

#, python-brace-format
msgid ""
"Paused: two-way needs a playlist {name} owns in Tidal, and they only "
"follow this one."
msgstr ""
"En pause : le partage dans les deux sens demande une playlist qui "
"appartient à {name} dans Tidal, et cette personne ne fait que la suivre."

msgid ""
"The last sync didn't come out as expected. Trobar tries again at the next"
" one."
msgstr ""
"La dernière synchronisation n'a pas donné le résultat attendu. Trobar "
"réessaie à la prochaine."

#, python-brace-format
msgid ""
"Your original was kept: {name}'s copy lacks some of its tracks (by "
"position in your playlist: {positions}). Remove those from your playlist "
"in Tidal and ask again, or keep the original."
msgstr ""
"Votre original a été gardé : il manque des titres à la copie de {name} "
"(par position dans votre playlist : {positions}). Retirez-les de votre "
"playlist dans Tidal et redemandez, ou gardez l'original."

#, python-brace-format
msgid "Your original was kept: {name}'s copy no longer exists in Tidal."
msgstr "Votre original a été gardé : la copie de {name} n'existe plus dans Tidal."

msgid ""
"Your original was kept: you only follow that playlist in Tidal, so it "
"isn't yours to delete."
msgstr ""
"Votre original a été gardé : vous ne faites que suivre cette playlist "
"dans Tidal, ce n'est donc pas à vous de la supprimer."

msgid "Your original was kept: it's still shared with someone else."
msgstr "Votre original a été gardé : il est encore partagé avec quelqu'un d'autre."

msgid "Share with…"
msgstr "Partager avec…"

msgid "Tidal playlists shared with you"
msgstr "Playlists Tidal partagées avec vous"

msgid "Accept is still possible. The copy appears once you reconnect Tidal."
msgstr ""
"Vous pouvez quand même accepter. La copie apparaît une fois Tidal "
"reconnecté."

msgid "Decline"
msgstr "Refuser"

msgid "Stop sharing"
msgstr "Arrêter le partage"

msgid "Tidal playlists you share"
msgstr "Playlists Tidal que vous partagez"

msgid "Your original was deleted."
msgstr "Votre original a été supprimé."

msgid "Withdraw"
msgstr "Retirer"

msgid "Delete my original…"
msgstr "Supprimer mon original…"

msgid "Keep my original"
msgstr "Garder mon original"

msgid ""
"Trobar keeps a copy of this playlist in their own Tidal account, with the"
" same title, and updates it on each playlist sync."
msgstr ""
"Trobar garde une copie de cette playlist dans le compte Tidal de la "
"personne, avec le même titre, et la met à jour à chaque synchronisation "
"des playlists."

msgid "Nobody else here has Tidal linked yet."
msgstr "Personne d'autre ici n'a encore lié Tidal."

msgid "With"
msgstr "Avec"

msgid "Two-way: their changes come back to your playlist."
msgstr "Dans les deux sens : ses modifications reviennent dans votre playlist."

msgid ""
"A track removed on either side is removed on both; additions from both "
"are kept, theirs at the end. Off: your playlist wins, and their copy is "
"rewritten to match it."
msgstr ""
"Un titre retiré d'un côté est retiré des deux ; les ajouts des deux côtés"
" sont gardés, les siens à la fin. Désactivé : votre playlist l'emporte, "
"et sa copie est réécrite pour lui correspondre."

msgid "Share now, without asking them"
msgstr "Partager maintenant, sans demander"

msgid ""
"Admins only. The copy appears in their Tidal account at the next playlist"
" sync, with no invitation."
msgstr ""
"Administrateurs seulement. La copie apparaît dans son compte Tidal à la "
"prochaine synchronisation des playlists, sans invitation."

msgid ""
"Before deleting, Trobar checks that the copy still has every track of "
"yours. If any is missing, even one their region doesn't offer, your "
"original is kept and you're told which."
msgstr ""
"Avant de supprimer, Trobar vérifie que la copie a encore tous vos titres."
" S'il en manque un, même indisponible dans sa région, votre original est "
"gardé et on vous dit lesquels."

msgid "This can't be undone."
msgstr "Impossible de revenir en arrière."

msgid "Keep it"
msgstr "Le garder"

msgid "Delete my original"
msgstr "Supprimer mon original"

msgid "Only the owner can delete their playlist."
msgstr "Seul le propriétaire peut supprimer sa playlist."

msgid "The original has already been deleted."
msgstr "L'original a déjà été supprimé."

msgid "End the share before deleting the original."
msgstr "Mettez fin au partage avant de supprimer l'original."

msgid "No copy was ever made, so the original is the only one."
msgstr "Aucune copie n'a été créée : l'original est le seul exemplaire."

msgid "This playlist is still shared with someone else."
msgstr "Cette playlist est encore partagée avec quelqu'un d'autre."

msgid "That user doesn't exist."
msgstr "Cet utilisateur n'existe pas."

msgid "This playlist is already shared with them."
msgstr "Cette playlist est déjà partagée avec cette personne."

msgid "This share has already ended."
msgstr "Ce partage est déjà terminé."

msgid "This share isn't waiting for an answer."
msgstr "Ce partage n'attend pas de réponse."

