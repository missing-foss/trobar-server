msgstr ""
"Chaque playlist doit avoir un chemin (un fichier .m3u ou .m3u8, relatif, "
"sans « .. ») et une liste d'entrées."

#: main.py:7812
msgid "after, limit, and computed_after must be whole numbers."
msgstr "after, limit et computed_after doivent être des nombres entiers."

#: main.py:7814
msgid "after must be 0 or more and limit at least 1."
msgstr "after doit être supérieur ou égal à 0 et limit au moins 1."

#: main.py:7876
msgid "entries must be a list."
msgstr "entries doit être une liste."

#: main.py:7879
msgid "Too many entries in one request — push them in smaller pages."
msgstr ""
"Trop d'entrées dans une seule requête — envoyez-les par pages plus "
