#: main.py:7889
msgid "Each entry needs a non-empty path and fingerprint."
msgstr "Chaque entrée doit avoir un path et une fingerprint non vides."

#: main.py:7891
msgid "track_id must be a whole number when given."
msgstr "track_id doit être un nombre entier lorsqu'il est fourni."

