#: main.py:1291
#, python-brace-format
msgid "Delete “{username}”?"
msgstr "Supprimer « {username} » ?"

#: main.py:1292
msgid "This account can't be deleted yet — it still owns:"
msgstr "Ce compte ne peut pas encore être supprimé — il possède encore :"

#: main.py:1294
msgid ""
"Delete those first. Ownership can't be transferred from here: delegation "
"lets someone else manage a device without owning it, and a playlist's "
"owner only changes by re-syncing it."
msgstr ""
"Supprimez-les d'abord. La propriété ne peut pas être transférée ici : la "
"délégation permet à quelqu'un d'autre de gérer un appareil sans le "
"posséder, et le propriétaire d'une playlist ne change qu'en la "
"resynchronisant."

#: main.py:1297
msgid "This permanently deletes the account."
msgstr "Cette action supprime définitivement le compte."

#: main.py:1299
