#: app/user_profile.py
msgid "That value can't be used."
msgstr "Cette valeur n'est pas utilisable."

#: app/user_profile.py
msgid "The server's credential key can't be used."
msgstr "La clé de chiffrement du serveur n'est pas utilisable."

#: app/user_profile.py
msgid "Also send my plays to"
msgstr "Envoyer aussi mes écoutes à"

#: app/user_profile.py
msgid "Each is your own choice, and each play goes once. Plays from before you turn one on stay here."
msgstr "Chacun est votre choix, et chaque écoute part une seule fois. Les écoutes antérieures à l'activation restent ici."

#: app/user_profile.py
msgid "This removes them from Trobar and can't be undone. Plays already sent stay where they went."
msgstr "Elles sont retirées de Trobar, sans retour possible. Les écoutes déjà envoyées restent là où elles sont allées."

#: app/user_profile.py
msgid "Add your Maloja URL in Scrobbler accounts."
msgstr "Ajoutez votre adresse Maloja dans les comptes de scrobbling."

#: app/user_profile.py
msgid "Add your Maloja API key in Scrobbler accounts."
msgstr "Ajoutez votre clé d'API Maloja dans les comptes de scrobbling."

#: app/user_profile.py
msgid "Add your ListenBrainz username in Scrobbler accounts."
msgstr "Ajoutez votre nom d'utilisateur ListenBrainz dans les comptes de scrobbling."

#: app/user_profile.py
msgid "Add your ListenBrainz user token in Scrobbler accounts."
msgstr "Ajoutez votre jeton utilisateur ListenBrainz dans les comptes de scrobbling."

#: app/user_profile.py
msgid "Enter it again in Scrobbler accounts."
msgstr "Saisissez-le à nouveau dans les comptes de scrobbling."

#: app/user_profile.py
msgid "It refused the credential: check it in Scrobbler accounts."
msgstr "Il a refusé l'identifiant : vérifiez-le dans les comptes de scrobbling."

#: app/user_profile.py
msgid "It didn't answer. Plays go when it's back, with the next ones."
msgstr "Il n'a pas répondu. Les écoutes partiront à son retour, avec les suivantes."

#: app/user_profile.py
msgid "Add its details under Scrobbler accounts first."
msgstr "Ajoutez d'abord ses informations dans les comptes de scrobbling."

#: app/main.py
msgid "It rejected {n} play, which won't be sent."
msgstr "Il a rejeté {n} écoute, qui ne sera pas envoyée."

#: app/main.py
msgid "It rejected {n} plays, which won't be sent."
msgstr "Il a rejeté {n} écoutes, qui ne seront pas envoyées."

#: app/main.py
msgid "The ListenBrainz user token, the Maloja API key and the Last.fm session are stored encrypted."
msgstr "Le jeton utilisateur ListenBrainz, la clé d'API Maloja et la session Last.fm sont stockés chiffrés."

#: app/main.py
msgid "Connect Last.fm"
msgstr "Connecter Last.fm"

#: app/main.py
msgid "An admin needs to set up Last.fm first."
msgstr "Un administrateur doit d'abord configurer Last.fm."

#: app/main.py
msgid "Connect Last.fm in Scrobbler accounts."
msgstr "Connectez Last.fm dans les comptes de scrobbling."

#: app/main.py
msgid "Last.fm isn't set up yet: ask an admin to add its API account."
msgstr "Last.fm n'est pas encore configuré : demandez à un administrateur d'ajouter son compte d'API."

#: app/main.py
msgid "Last.fm API account for sending plays: API key"
msgstr "Compte d'API Last.fm pour envoyer les écoutes : clé d'API"

#: app/main.py
msgid "Shared secret"
msgstr "Secret partagé"

#: app/main.py
msgid "Create an API account at last.fm/api. Members can then connect their own Last.fm to send plays. The shared secret is stored encrypted."
msgstr "Créez un compte d'API sur last.fm/api. Les membres pourront alors connecter leur Last.fm pour envoyer leurs écoutes. Le secret partagé est stocké chiffré."

#: app/templates/index.html
msgid "Last.fm wasn't connected. Try again."
msgstr "Last.fm n'a pas été connecté. Réessayez."
