#: main.py:1410
#, python-brace-format
msgid ""
"Nothing has changed yet. This is what switching from {from} to {to} does,"
" counted on this server just now. Only {from}'s own playlists are "
"affected."
msgstr ""
"Rien n'a encore changé. Voici ce que fait le passage de {from} à {to}, "
"compté à l'instant sur ce serveur. Seules les playlists propres à {from} "
"sont concernées."

#: main.py:1412
#, python-brace-format
msgid "Removed: {n} playlist from {from}"
msgstr "Supprimée : {n} playlist de {from}"

#: main.py:1413
#, python-brace-format
msgid "Removed: {n} playlists from {from}"
msgstr "Supprimées : {n} playlists de {from}"

#: main.py:1415
#, python-brace-format
msgid "Removed: no playlists, {from} has none of its own"
msgstr "Supprimées : aucune playlist, {from} n'en a aucune en propre"

#: main.py:1417 main.py:1418
#, python-brace-format
msgid "Carried over: {n} of {from}'s {of} playlists"
msgstr "Reprises : {n} des {of} playlists de {from}"

#: main.py:1420
