TZ=UTC

# Which peer(s) waitress trusts to set X-Forwarded-For/-Host/-Proto.
#
# SECURITY: this is also what the per-IP brute-force rate limiter (login,
# device pairing, device tokens) trusts to say who a request is really from.
# If this container's port is reachable by anything other than your reverse
# proxy, "*" trusts an attacker's own X-Forwarded-For just as readily as a
# real proxy's, and the rate limiter can be bypassed by rotating a fake IP
# per request.
#
# "*" (any peer) is the CORRECT and sufficient default for THIS file: the
# port below is bound to 127.0.0.1 only, so nothing but a process on this
# host can reach it directly. That's a real barrier, just a narrower one
# than a fully internal-only Docker network with no published port at all
# (an alternative topology you can set up yourself). Don't treat pinning as
# a hardening step to reach for by default on either topology.
#
# If you DO need to pin it: do NOT use 127.0.0.1. Docker's port publishing
# doesn't preserve that address inside the container — behind a
# 127.0.0.1:<port>:<port> mapping, a request to 127.0.0.1:5000 on the host
# arrives from a Docker bridge gateway address instead (something in the
# 172.x.0.1 shape), never from 127.0.0.1. waitress matches by raw string
# equality against the connecting socket peer — never a hostname, container
# name, DNS lookup, or "the address you dialed" — so 127.0.0.1 never matches
# anything, ever, and a pin that doesn't match is WORSE than "*": every real
# request gets its X-Forwarded-For stripped, and every user collapses into
# ONE shared rate-limit bucket keyed on the proxy's own address — one
# mistyped password can lock out the whole household.
#
# The value that actually matches is your own deployment's Docker bridge
# gateway (find it with `docker network inspect`, see
# docs/operations/networking.md#trusted-proxy-and-rate-limiting) — stable
# across `docker compose up --force-recreate`, but assigned by Docker per
# project/host, not a fixed value. Re-check it if you ever fully tear the
# network down (`docker compose down`) rather than just recreating the
# container.
TROBAR_TRUSTED_PROXY=*

# Required
MUSIC_ROOT=/music
DATA_DIR=/data
ADMIN_USERNAME=

# Required — the HOST-side paths docker-compose.yaml mounts at MUSIC_ROOT/
# DATA_DIR above (read directly by docker compose from this file, not passed
# into the container as env vars themselves).
#
# MUSIC_VOLUME can be anything, including a NAS mount (NFS/SMB) — Trobar only
# ever reads your library.
#
# DATA_VOLUME must be on LOCAL DISK. It holds a SQLite database, which needs
# working file locking; NFS/SMB shares don't provide it reliably and CAN CORRUPT
# the database, losing your selections, device pairings and playlists. If you
# want this data on your NAS, back it up there rather than running it from
# there. See docs/getting-started/installation.md.
MUSIC_VOLUME=/path/to/your/music
DATA_VOLUME=./data

# Auth mode: local | oidc | forward   (default: local)
#   local   — the app's own username/password accounts. First launch walks you
#             through creating the admin account. Simplest; no external system.
#   oidc    — the app is an OpenID Connect client and verifies a signed ID token
#             from your IdP (Authentik, Authelia, Keycloak, …). Recommended SSO.
#             Fill in the OIDC_* block below.
#   forward — trust identity headers set by a ForwardAuth reverse proxy. The app
#             does NO auth of its own in this mode: the proxy MUST gate every
#             request and this port must NEVER be exposed directly. Set
#             FORWARD_AUTH_SECRET (below) to fail-closed. ("authentik" is
#             accepted as an alias for this mode.)
AUTH_MODE=local

# Required only when AUTH_MODE=oidc
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Optional OIDC tuning
OIDC_SCOPES=openid profile email
OIDC_USERNAME_CLAIM=preferred_username
OIDC_LOGOUT=false

# Optional, only for AUTH_MODE=forward: a shared secret your proxy injects as
# the X-Forward-Auth-Secret header. When set, requests without it are rejected
# (fail-closed against a directly-exposed port). Strongly recommended.
FORWARD_AUTH_SECRET=

# Optional — Roon integration (can also be set later from the admin UI)
ROON_HOST=
ROON_PORT=9330

# Optional — app-wide fallback Last.fm key; each user can set their own instead
LASTFM_API_KEY=

# Optional — playlist mirroring (#285): lets any user mirror a playlist to a
# Trobar-managed .m3u file, kept in sync as your library grows. Off unless
# MIRROR_VOLUME is set here AND a mirror folder is also set in Administration
# > Configuration (both must point at the same place). Must be a separate
# folder from MUSIC_VOLUME/MUSIC_ROOT above, and writable (unlike the
# read-only music mount).
MIRROR_VOLUME=

# Optional — only meaningful in AUTH_MODE=forward behind a ForwardAuth-style
# gate (a break-glass local login during a proxy/SSO outage). Never expose this
# port to the public internet. See README.
EMERGENCY_PORT=0

# Optional — how much Trobar logs: DEBUG, INFO, WARNING, ERROR, CRITICAL.
# Default WARNING. Raise it to diagnose a provider problem (INFO adds things
# like Tidal/Spotify retry breadcrumbs). An unrecognised value warns and falls
# back to WARNING rather than refusing to start.
#
# DEBUG is safe to leave on while you're diagnosing: it applies to Trobar's own
# logging only, never to the HTTP libraries underneath. Those log full request
# URLs at debug level, and some music servers carry authentication in the query
# string, so a blanket debug setting would write credentials into your logs.
LOG_LEVEL=WARNING
